{
  "name": "@erwanjugand/eslint-config",
  "packageManager": "pnpm@11.5.2",
  "version": "2.4.0",
  "author": "Erwan Jugand <erwan.jugand@gmail.com>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erwanjugand/eslint-config.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "check:prettier": "prettier --check .",
    "check:lint": "eslint",
    "check:ts": "tsc --noEmit",
    "check:all": "pnpm check:prettier && pnpm check:lint && pnpm check:ts",
    "fix:prettier": "prettier --log-level warn --write .",
    "fix:lint": "pnpm check:lint --fix",
    "fix:all": "pnpm fix:prettier && pnpm fix:lint"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.4.0",
    "jiti": "^2.7.0",
    "typescript-eslint": "^8.58.0"
  },
  "devDependencies": {
    "@erwanjugand/prettier-config": "1.0.1",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.3",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  }
}
